<ci:SettingsPageBase
    x:Class="CameraActivityMonitor.Views.CameraActivityMonitorSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:converters="clr-namespace:CameraActivityMonitor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:CameraActivityMonitor.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Design.DataContext>
        <viewModels:SettingsPageViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <ScrollViewer.Resources>
            <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter" />
            <converters:BooleanToIsUseStatusConverter x:Key="BooleanToIsUseStatusConverter" />
        </ScrollViewer.Resources>

        <StackPanel Classes="settings-container animated-intro">
            <controls:SettingsExpander>
                <controls:SettingsExpander.Header>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="当前状态：" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding IsMonitoring, Converter={StaticResource BooleanToStatusConverter}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="摄像头状态：" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding IsCameraInUse, Converter={StaticResource BooleanToIsUseStatusConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsExpander.Header>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="选择摄像头"
                IconSource="{ci:FluentIconSource &#xE392;}"
                IsExpanded="True">
                <controls:SettingsExpander.Footer>
                    <ComboBox
                        Width="260"
                        ItemsSource="{Binding Cameras}"
                        SelectedItem="{Binding SelectedCamera, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ci:AnimatedIconButton
                        Classes.fade="{Binding IsMonitoring}"
                        Classes.foreground-accent="{Binding !IsMonitoring}"
                        Command="{Binding StartMonitorCommand}"
                        Glyph="&#xEDB9;"
                        IsKeepingExpanded="{Binding !IsMonitoring}"
                        Text="开启" />
                    <ci:AnimatedIconButton
                        Classes.fade="{Binding !IsMonitoring}"
                        Classes.foreground-accent="{Binding IsMonitoring}"
                        Command="{Binding StopMonitorCommand}"
                        Glyph="&#xEE67;"
                        IsKeepingExpanded="{Binding IsMonitoring}"
                        Text="关闭" />
                    <ci:AnimatedIconButton
                        Classes.fade="{Binding RefreshCommand.IsRunning}"
                        Classes.foreground-accent="{Binding !RefreshCommand.IsRunning}"
                        Command="{Binding RefreshCommand}"
                        Glyph="&#xE161;"
                        IsKeepingExpanded="{Binding !RefreshCommand.IsRunning}"
                        Text="刷新" />
                    <controls:ProgressRing
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        IsActive="{Binding RefreshCommand.IsRunning}" />
                </StackPanel>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="自动开启监控" IconSource="{ci:FluentIconSource &#xE342;}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AutoStart, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>

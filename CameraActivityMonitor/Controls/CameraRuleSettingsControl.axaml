<ci:RuleSettingsControlBase
    x:Class="CameraActivityMonitor.Controls.CameraRuleSettingsControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CameraActivityMonitor.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:CameraActivityMonitor.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="settings:CameraRuleSettings"
    mc:Ignorable="d">
    <WrapPanel
        Classes="items-valign-center"
        DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:CameraRuleSettingsControl}}"
        Orientation="Horizontal">
        <CheckBox
            Content="匹配进程名"
            IsChecked="{Binding Settings.MatchProcessName, Mode=TwoWay}"
            ToolTip.Tip="同时匹配 Media Foundation 和注册表来源的占用进程名；注册表来源通常为可执行文件名（不含 .exe）。" />
        <TextBox
            MinWidth="100"
            IsVisible="{Binding Settings.MatchProcessName}"
            Text="{Binding Settings.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip.Tip="可填写进程名或 .exe 文件名，不区分大小写。" />
    </WrapPanel>
</ci:RuleSettingsControlBase>
